import { PassThrough } from 'node:stream';

import type { EntryContext } from 'react-router';
import { createReadableStreamFromReadable } from '@react-router/node';
import { ServerRouter } from 'react-router';
import { isbot } from 'isbot';
import type { RenderToPipeableStreamOptions } from 'react-dom/server';
import { renderToPipeableStream } from 'react-dom/server';

export const streamTimeout = 5_000;

export default function handleRequest(
    request: Request,
    responseStatusCode: number,
    responseHeaders: Headers,
    routerContext: EntryContext
) {
    // Make the browser fetch the page HTML from the server every time
    // (it contains JS / CSS file names that change with every build)
    if (!responseHeaders.has('Cache-Control')) {
        responseHeaders.set('Cache-Control', 'private, no-cache, no-store, max-age=0, must-revalidate');
    }

    // When a loader returns a non-HTML Response (XML such as a feed or sitemap), return it as is without rendering the page
    const contentType = responseHeaders.get('Content-Type');
    if (contentType && !contentType.startsWith('text/html')) {
        const { loaderData, matches } = routerContext.staticHandlerContext;
        const body = loaderData[matches[matches.length - 1].route.id];
        if (typeof body === 'string') {
            return new Response(request.method.toUpperCase() === 'HEAD' ? null : body, {
                status: responseStatusCode,
                headers: responseHeaders,
            });
        }
    }

    // https://httpwg.org/specs/rfc9110.html#HEAD
    if (request.method.toUpperCase() === 'HEAD') {
        return new Response(null, {
            status: responseStatusCode,
            headers: responseHeaders,
        });
    }

    return new Promise((resolve, reject) => {
        let shellRendered = false;
        const userAgent = request.headers.get('user-agent');

        // For bots such as search engines, respond only after everything has been rendered
        const readyOption: keyof RenderToPipeableStreamOptions =
            (userAgent && isbot(userAgent)) || routerContext.isSpaMode ? 'onAllReady' : 'onShellReady';

        // Abort rendering once streamTimeout has passed
        let timeoutId: ReturnType<typeof setTimeout> | undefined = setTimeout(() => abort(), streamTimeout + 1000);

        const { pipe, abort } = renderToPipeableStream(<ServerRouter context={routerContext} url={request.url} />, {
            [readyOption]() {
                shellRendered = true;
                const body = new PassThrough({
                    final(callback) {
                        clearTimeout(timeoutId);
                        timeoutId = undefined;
                        callback();
                    },
                });
                const stream = createReadableStreamFromReadable(body);

                responseHeaders.set('Content-Type', 'text/html; charset=utf-8');

                pipe(body);

                resolve(
                    new Response(stream, {
                        headers: responseHeaders,
                        status: responseStatusCode,
                    })
                );
            },
            onShellError(error: unknown) {
                reject(error);
            },
            onError(error: unknown) {
                responseStatusCode = 500;
                // Log rendering errors that happen after the shell has been sent here
                // (shell rendering errors are logged on the reject side)
                if (shellRendered) {
                    console.error(error);
                }
            },
        });
    });
}
